#!/usr/bin/env zsh

set -euo pipefail

PROJECT_DIR="${PWD:A}"
SANDBOX_NAME="${PROJECT_DIR:t}"
PORT="3000:3000"

die() {
  print -u2 -- "sandbox: $*"
  exit 1
}

usage() {
  cat <<'USAGE'
Uso: sandbox <comando>

  create <agent>  Cria o sandbox para o agente e publica a porta 3000
  start   Inicia e conecta ao agente do sandbox
  shell   Abre um shell interativo no sandbox
  stop    Para o sandbox preservando seu estado
  remove  Remove o sandbox da pasta atual
  hunk    Executa hunk diff --watch dentro do sandbox
USAGE
}

require_sbx() {
  command -v sbx >/dev/null 2>&1 || die "sbx não encontrado no PATH"
  [[ "$SANDBOX_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] ||
    die "nome de pasta inválido para o sbx: $SANDBOX_NAME"
  (( ${#SANDBOX_NAME} >= 2 )) || die "o nome da pasta deve ter ao menos dois caracteres"
  [[ "$SANDBOX_NAME" != default ]] || die '"default" é reservado pelo sbx'
}

exists() {
  sbx ls --quiet | while IFS= read -r name; do
    [[ "$name" == "$SANDBOX_NAME" ]] && return 0
  done
  return 1
}

create() {
  local agent="${1:-}"
  [[ -n "$agent" ]] || die "informe o agente; exemplo: sandbox create codex"
  exists && die "sandbox já existe: $SANDBOX_NAME"
  sbx create --name "$SANDBOX_NAME" --publish "$PORT" "$agent" "$PROJECT_DIR"
  print "\nContinue no sandbox com:\n  sandbox start"
}

start() {
  exists || die "sandbox não existe: $SANDBOX_NAME; execute: sandbox create <agent>"
  sbx run --name "$SANDBOX_NAME"
}

open_shell() {
  exists || die "sandbox não existe: $SANDBOX_NAME; execute: sandbox create <agent>"
  sbx exec -it --workdir "$PROJECT_DIR" "$SANDBOX_NAME" /bin/sh -c \
    'if command -v zsh >/dev/null 2>&1; then exec zsh; elif command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi'
}

hunk_watch() {
  exists || die "sandbox não existe: $SANDBOX_NAME; execute: sandbox create <agent>"
  sbx exec -it --workdir "$PROJECT_DIR" "$SANDBOX_NAME" hunk diff --watch
}

require_sbx

case "${1:-}" in
  create) create "${2:-}" ;;
  start) start ;;
  shell) open_shell ;;
  stop)
    exists || die "sandbox não existe: $SANDBOX_NAME"
    sbx stop "$SANDBOX_NAME"
    ;;
  remove)
    exists || die "sandbox não existe: $SANDBOX_NAME"
    sbx rm "$SANDBOX_NAME"
    ;;
  hunk) hunk_watch ;;
  help|-h|--help|'') usage ;;
  *) usage; die "comando desconhecido: $1" ;;
esac
