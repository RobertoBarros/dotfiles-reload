# Track personal configuration; Herdr regenerates its own files and runtime state.
/*
!/.gitignore
!/settings.json
!/keys.json
!/programs.json
!/themes/
!/layouts/
!/mods/

# Bundled themes, layouts and mods are maintained by Herdr.
/themes/atom-one-dark.json
/themes/win98.json
/layouts/.state/
/layouts/win98.svg
/mods/agents/
/mods/changes/
/mods/confirm/
/mods/files/
/mods/help/
/layouts/main.json
/layouts/terminals.json
/layouts/win98.json
/mods/machine-add/
/mods/menu/
/mods/new-menu/
/mods/pane/
/mods/peek/
/mods/picker/
/mods/prompt/
/mods/spaces/
/mods/tabs/
/mods/terminals-bar/
/mods/terminals-pane/
/mods/toast/
/mods/win98/
/mods/workspace-chrome/
/mods/workspace-status/
/mods/worktree/

# Generated mod metadata and temporary files.
**/*.d.ts
**/jsconfig.json
**/node_modules/
**/.DS_Store
**/*.error
**/*.reset-*
**/*.old-*
